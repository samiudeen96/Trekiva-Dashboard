// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Carrier API settings, one row per shop and carrier. Credentials live only
// in secretsEnc (AES-256-GCM) and are never returned to the browser.
model CarrierSetting {
  id                  String   @id @default(cuid())
  shop                String
  carrier             String // "ekart" | "xpressbees" | "delhivery"
  enabled             Boolean  @default(false)
  useStaging          Boolean  @default(false) // Delhivery staging and production tokens are not interchangeable
  accountId           String?
  trackingUrlTemplate String? // customer-facing fallback link, uses {awb}
  secretsEnc          String? // encrypted JSON: { apiKey?, password? }
  updatedAt           DateTime @updatedAt

  @@unique([shop, carrier])
}

// Last tracking result per shipment: serves as a short cache, keeps delivered
// shipments from being re-fetched, and is shown (clearly marked) when the
// carrier can't be reached. Only read after the order's owner is verified.
model TrackingSnapshot {
  id       String   @id @default(cuid())
  shop     String
  carrier  String
  awb      String
  data     String // JSON of CarrierTracking
  syncedAt DateTime

  @@unique([shop, carrier, awb])
}
